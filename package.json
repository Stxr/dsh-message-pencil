{
  "name": "@local/dsh-message-pencil",
  "version": "1.1.2",
  "private": false,
  "author": "Stxr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stxr/dsh-message-pencil.git"
  },
  "homepage": "https://github.com/Stxr/dsh-message-pencil#readme",
  "bugs": {
    "url": "https://github.com/Stxr/dsh-message-pencil/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "message-editing"],
  "type": "module",
  "description": "Edit sent messages, discard later history and regenerate in the same conversation.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "visibility.js",
    "build.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "VERIFICATION.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node tests/run.js"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "immer": "10.1.3",
    "react": "19.1.1",
    "tsx": "4.20.6",
    "zustand": "5.0.8"
  }
}
