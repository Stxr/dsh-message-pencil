{
  "name": "@local/dsh-message-pencil",
  "version": "1.1.3",
  "private": false,
  "author": "Stxr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stxr/dsh-message-pencil.git"
  },
  "homepage": "https://github.com/Stxr/dsh-message-pencil#readme",
  "bugs": {
    "url": "https://github.com/Stxr/dsh-message-pencil/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "message-editing"],
  "type": "module",
  "description": "Edit sent messages, discard later history and regenerate in the same conversation.",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "tsconfig.build.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/ARCHITECTURE.md",
    "VERIFICATION.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.1.16",
    "@types/react-test-renderer": "19.1.0",
    "esbuild": "0.25.12",
    "react-test-renderer": "19.1.1",
    "typescript": "5.9.3",
    "immer": "10.1.3",
    "react": "19.1.1",
    "tsx": "4.20.6",
    "zustand": "5.0.8"
  }
}
